{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/releases",
      "destination": "https://github.com/crumexhtx/PeakAtlas3D/blob/main/CHANGELOG.md",
      "permanent": true
    },
    {
      "source": "/peak/rittenhouse",
      "destination": "/peak/vinson",
      "permanent": true
    },
    {
      "source": "/peak/dufourspitze",
      "destination": "/peak/monterosa",
      "permanent": true
    },
    {
      "source": "/peak/citlaltepetl",
      "destination": "/peak/iztaccihuatl",
      "permanent": true
    },
    {
      "source": "/countries/switzerland-italy",
      "destination": "/countries/switzerland",
      "permanent": true
    },
    {
      "source": "/countries/chile-argentina",
      "destination": "/countries/chile",
      "permanent": true
    },
    {
      "source": "/countries/kyrgyzstan-tajikistan",
      "destination": "/countries/kyrgyzstan",
      "permanent": true
    },
    {
      "source": "/countries/poland-slovakia",
      "destination": "/countries/poland",
      "permanent": true
    },
    {
      "source": "/countries/uganda-dr-congo",
      "destination": "/countries/uganda",
      "permanent": true
    },
    {
      "source": "/countries/venezuela-brazil-guyana",
      "destination": "/countries/venezuela",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sitemap\\.xml$|robots\\.txt$|favicon\\.svg$).*)",
      "destination": "/index.html"
    }
  ]
}
